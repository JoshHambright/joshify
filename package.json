{
  "name": "joshify",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A touchscreen control surface for Spotify, for a Raspberry Pi 5",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build && pnpm --filter @joshify/ui check",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build": "pnpm --recursive --if-present build",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm coverage && pnpm build",
    "clean": "tsc --build --clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.23.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.0",
    "fastify": "5.12.3",
    "jimp": "1.6.1"
  }
}
