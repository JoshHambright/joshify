{
  "name": "joshify",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A touchscreen control surface for Spotify, for a Raspberry Pi 5",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build": "pnpm --recursive --if-present build",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm coverage && pnpm build",
    "clean": "tsc --build --clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
