# Joshify environment — copy to .env and fill in.
# .env is gitignored and must never be committed.
#
# Not needed until P1-02. See docs/SPOTIFY_SETUP.md.

# From the Spotify Developer Dashboard. Not sensitive — it travels in the
# authorize URL in plain sight by design.
SPOTIFY_CLIENT_ID=

# There is deliberately no SPOTIFY_CLIENT_SECRET here. Joshify uses
# Authorization Code with PKCE, which completes with no secret at any step
# (spike P1-01). A secret we never read is only something to leak.

# Must be HTTPS or a literal loopback address; `localhost` is rejected.
# Settled by spike P1-01. The port is part of Spotify's exact match, so
# changing it means registering the new URI too.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# Local server bind. Loopback only by default (P2-07).
JOSHIFY_HOST=127.0.0.1
JOSHIFY_PORT=8080
