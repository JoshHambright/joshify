# Joshify environment — copy to .env and fill in.
# .env is gitignored and must never be committed.
#
# Not needed until P1-02. See docs/SPOTIFY_SETUP.md.

# From the Spotify Developer Dashboard.
SPOTIFY_CLIENT_ID=

# Joshify uses Authorization Code with PKCE, so the device itself does not
# need the secret at runtime. Kept here for local tooling only.
SPOTIFY_CLIENT_SECRET=

# Must be HTTPS or a literal loopback address. `localhost` is rejected by
# Spotify. The exact value is being settled by spike P1-01.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# Local server bind. Loopback only by default (P2-07).
JOSHIFY_HOST=127.0.0.1
JOSHIFY_PORT=8080
