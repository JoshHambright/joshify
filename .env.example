# Joshify environment — copy to .env and fill in.
# .env is gitignored and must never be committed.
#
# Not needed until P1-02. See docs/SPOTIFY_SETUP.md.

# From the Spotify Developer Dashboard. Not sensitive — it travels in the
# authorize URL in plain sight by design.
SPOTIFY_CLIENT_ID=

# There is deliberately no SPOTIFY_CLIENT_SECRET here. Joshify uses
# Authorization Code with PKCE, which completes with no secret at any step
# (spike P1-01). A secret we never read is only something to leak.

# Must be HTTPS or a literal loopback address; `localhost` is rejected.
# Settled by spike P1-01. The port is part of Spotify's exact match, so
# changing it means registering the new URI too.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# Two ports, and they are not the same one. This trips people up.
#
# JOSHIFY_PORT is the OAuth callback listener, and it exists only for the few
# seconds `joshify auth` is running. It has to match SPOTIFY_REDIRECT_URI
# above exactly, because Spotify compares the whole string.
JOSHIFY_PORT=8080

# JOSHIFY_SERVE_PORT is where the panel lives: the API, the WebSocket and the
# UI itself, for as long as the device is on. This is the one the kiosk
# browser opens.
JOSHIFY_SERVE_PORT=4770

# Loopback only by default (P2-07, D-034). This process can start music on the
# account, and a home LAN is full of devices nobody audits.
JOSHIFY_HOST=127.0.0.1

# ISO country code. Without it Spotify lists tracks that are not licensed
# where the device is, and tapping one fails at play time rather than simply
# not being offered. Optional.
# JOSHIFY_MARKET=US
